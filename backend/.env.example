PROJECT_NAME="Autonomous Enterprise Incident Resolution Engine"
ENVIRONMENT="development"
CORS_ORIGINS=["*"]

# Local SQLite database
DATABASE_URL="sqlite+aiosqlite:///./sentinelx.db"

# AI layers. Keep MOCK=true until those services are running.
AI_LAYER_1_URL="http://localhost:8001/api/v1"
AI_LAYER_2_URL="http://localhost:8002/api/v1"
AI_LAYER_1_MOCK=true
AI_LAYER_2_MOCK=true
AI_HTTP_TIMEOUT_SECONDS=30

SECRET_KEY="your-super-secret-key-for-hackathon-only"

ALERT_DEDUP_WINDOW_SECONDS=120
INCIDENT_CORRELATION_WINDOW_SECONDS=900
ANALYSIS_DEBOUNCE_SECONDS=3
AUTO_REMEDIATE_LOW_RISK=true
GITHUB_WEBHOOK_SECRET=your-webhook-secret

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
